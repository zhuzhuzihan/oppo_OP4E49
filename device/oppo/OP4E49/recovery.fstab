# OrangeFox recovery.fstab for OPPO PECM30 (OP4E49)
# Mount point  partition              type  flags

# Logical partitions (dynamic)
/system         ext4    /dev/block/mapper/system                      flags=display="System";backup=1;flashimg=1;wipeingui;logical
/vendor         ext4    /dev/block/mapper/vendor                      flags=display="Vendor";backup=1;flashimg=1;wipeingui;logical
/product        ext4    /dev/block/mapper/product                     flags=display="Product";backup=1;flashimg=1;wipeingui;logical

# Data
/data           f2fs    /dev/block/by-name/userdata                   flags=display="Internal Storage";settingsstorage;backup=1;encryptable=footer;length=-16384;fileencryption=aes-256-xts:aes-256-cts:v1

# Boot partitions
/boot           emmc    /dev/block/by-name/boot                       flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/by-name/recovery                   flags=display="Recovery";backup=1;flashimg=1

# vbmeta
/vbmeta         emmc    /dev/block/by-name/vbmeta                     flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system              flags=display="Vbmeta System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor              flags=display="Vbmeta Vendor";backup=1;flashimg=1

# Metadata
/metadata       ext4    /dev/block/by-name/md_udc                     flags=display="Metadata";backup=1;flashimg=1;formattable

# Cache
/cache          ext4    /dev/block/by-name/cache                      flags=display="Cache";backup=1;flashimg=1;wipeingui;wipeingui;logical

# Vendor partitions
/mnt/vendor/protect_f   ext4    /dev/block/by-name/protect1           flags=display="Protect1";backup=1;flashimg=1
/mnt/vendor/protect_s   ext4    /dev/block/by-name/protect2           flags=display="Protect2";backup=1;flashimg=1
/mnt/vendor/nvdata      ext4    /dev/block/by-name/nvdata             flags=display="NVData";backup=1;flashimg=1
/mnt/vendor/nvcfg       ext4    /dev/block/by-name/nvcfg              flags=display="NVCfg";backup=1;flashimg=1

# USB OTG
/usb-otg        vfat    /dev/block/sdd1                               flags=display="USB OTG";storage;wipeingui;removable
/usbotg         vfat    /dev/block/by-name/special_preload            flags=display="USB OTG Alt";storage;wipeingui;removable

# SD card
/external_sd    auto    /devices/platform/externdevice*               flags=display="MicroSD";storage;wipeingui;removable;settingsstorage

# Persistent
/persistent     emmc    /dev/block/by-name/frp                        flags=display="Persistent";backup=1;flashimg=1

# Misc
/misc           emmc    /dev/block/by-name/misc                       flags=display="Misc";backup=1;flashimg=1
